# =============================================================
# Apollo 多数据库部署示例 —— 环境变量模板
# 复制为 .env，按需修改后与 docker-compose.example.yaml 配合使用。
# 仅需在 .env 中切换 APOLLO_DB_PROFILE 与对应连接串，即可在
# 达梦 / PostgreSQL / 人大金仓(PG模式) / MySQL 之间切换（重启生效）。
# =============================================================

# 数据库 Profile：postgre | dm | kingbase | mysql | h2
APOLLO_DB_PROFILE=postgre

# ---- ApolloConfigDB 连接（configservice / adminservice）----
CONFIG_DB_URL=jdbc:postgresql://host.docker.internal:5432/configdb
CONFIG_DB_USERNAME=postgres
CONFIG_DB_PASSWORD=change-me

# ---- ApolloPortalDB 连接（portal）----
PORTAL_DB_URL=jdbc:postgresql://host.docker.internal:5432/portaldb
PORTAL_DB_USERNAME=postgres
PORTAL_DB_PASSWORD=change-me

# ---- 服务注册 / meta 地址（按实际环境调整）----
# configservice/adminservice 通过 eureka 注册；portal 通过 meta 访问 configservice
CONFIG_SERVICE_HOST=configservice
ADMIN_SERVICE_HOST=adminservice
DEV_META=http://configservice:8080

# ----------------------------------------------------------------------
# 切到达梦时示例（需先在宿主机执行 scripts/install-dm-driver.sh 安装驱动）：
#   APOLLO_DB_PROFILE=dm
#   CONFIG_DB_URL=jdbc:dm://<dm-host>:5236?SCHEMA=APOLLOCONFIGDB
#   CONFIG_DB_USERNAME=SYSDBA
#   CONFIG_DB_PASSWORD=****
#   PORTAL_DB_URL=jdbc:dm://<dm-host>:5236?SCHEMA=APOLLOPORTALDB
# ----------------------------------------------------------------------
# 切到人大金仓（PG 模式）示例：
#   APOLLO_DB_PROFILE=kingbase
#   CONFIG_DB_URL=jdbc:postgresql://<kingbase-host>:54321/configdb
#   PORTAL_DB_URL=jdbc:postgresql://<kingbase-host>:54321/portaldb
# ----------------------------------------------------------------------